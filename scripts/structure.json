{
  "config": {
    "os_edge": {
      "wormhole": [
        "src/platform/"
      ],
      "wormhole-core": [
        "src/platform/"
      ],
      "wormhole-host": [
        "src/sys/"
      ],
      "wormhole-term": [
        "src/pty/",
        "src/sys/"
      ],
      "wormhole-text": [],
      "wormhole-wire": []
    },
    "os_edge_sanctioned": {
      "wormhole": {
        "src/perf/allocations.rs": {
          "tokens": {
            "allow(unsafe_code)": 1
          },
          "why": "a counting global allocator for test and devctl builds: GlobalAlloc is an unsafe trait, not OS code"
        }
      },
      "wormhole-term": {
        "src/client/thread.rs": {
          "tokens": {
            "allow(unsafe_code)": 1
          },
          "why": "polling's registration contract (the socket outlives its registration, kept by Drop), not OS code"
        }
      },
      "wormhole-host": {
        "src/serve.rs": {
          "tokens": {
            "allow(unsafe_code)": 1
          },
          "why": "polling's registration contract (every source is deleted from the poller before it is dropped), not OS code"
        }
      }
    },
    "os_edge_neutral": {
      "wormhole-core": [
        "src/platform/"
      ],
      "wormhole-host": [
        "src/sys/"
      ],
      "wormhole-term": [
        "src/sys/"
      ]
    },
    "impl_outside": {
      "crate": "wormhole",
      "types": [
        "Workspace",
        "Session"
      ],
      "homes": [
        "src/window/"
      ],
      "pending": []
    },
    "layers": {
      "wormhole": [
        [
          "menubar",
          "perf"
        ],
        "platform",
        "background",
        "window_open",
        "window_ops",
        "automation",
        [
          "active_profile",
          "icons",
          "palette",
          "theme_bridge"
        ],
        "settings",
        "fonts",
        "style",
        "notice",
        [
          "inspector",
          "intro",
          "select"
        ],
        [
          "dialog",
          "hotkey",
          "open_in"
        ],
        "terminal_view",
        "actions",
        "focus_keys",
        [
          "sidebar",
          "onboarding"
        ],
        [
          "app_state",
          "window"
        ],
        "aux_window",
        "features",
        "agent_access",
        "notifications",
        "update",
        "about",
        "studio",
        "settings_window",
        [
          "command_palette",
          "shortcut_sheet",
          "status_item"
        ],
        "app",
        "devctl"
      ],
      "wormhole-core": [
        [
          "keys",
          "platform",
          "storage"
        ],
        [
          "agents",
          "theme",
          "update"
        ],
        [
          "project",
          "view"
        ],
        "config",
        [
          "git",
          "notify"
        ],
        "ipc",
        "terminal",
        "import",
        "onboarding"
      ],
      "wormhole-wire": [
        [
          "error",
          "header"
        ],
        "cursor",
        "types",
        [
          "boot",
          "control",
          "event",
          "history",
          "stream"
        ],
        [
          "message",
          "version"
        ],
        [
          "decoder",
          "io",
          "samples"
        ]
      ],
      "wormhole-text": [
        [
          "args",
          "pseudo",
          "generated"
        ],
        "key",
        "language",
        "catalog",
        "active",
        "keys"
      ]
    },
    "module_depth": {
      "wormhole-core": 2
    },
    "bucket_names": [
      "text",
      "utils",
      "util",
      "misc",
      "helpers",
      "helper",
      "common"
    ],
    "size": {
      "warn": 600,
      "fail": 1000
    },
    "track_dirs": [
      "crates/wormhole/src/window"
    ],
    "feature_rules": {
      "crate": "wormhole",
      "features": "src/features/",
      "api": [
        "feature",
        "facts",
        "repo",
        "refresh_all_features",
        "redraw_windows_of"
      ],
      "workspace_files": [
        "def.rs",
        "api.rs",
        "devctl.rs"
      ],
      "frame": [
        "src/window/",
        "src/sidebar/",
        "src/onboarding/"
      ],
      "frame_bans": {
        "FeatureFlag::NotesAndTasks": "FeatureFlag\\s*::\\s*NotesAndTasks",
        "FeatureFlag::ProjectFolders": "FeatureFlag\\s*::\\s*ProjectFolders",
        "notes_on": "\\bnotes_on\\s*\\(",
        "usage_tab_on": "\\busage_tab_on\\s*\\(",
        "project_folders_on": "\\bproject_folders_on\\s*\\(",
        "RightTab": "\\bRightTab\\b",
        "TabId variant": "TabId\\s*::\\s*(?:Changes|History|Notes|Usage|Project)\\b"
      },
      "bridges": {
        "src/features/project/notes_sync.rs": {
          "notes": "the folder's notes.md and a terminal's notes and tasks are synced by the one file that needs both (notes' api)"
        }
      },
      "state_types": {
        "Workspace": "src/window/mod.rs",
        "Session": "src/window/session.rs",
        "AppState": "src/app_state/mod.rs"
      }
    }
  },
  "allowlist": {
    "file-size": {},
    "os-edge": {},
    "os-edge-neutral": {},
    "bucket-names": {},
    "orphans": {},
    "glob-imports": {},
    "cycles": {
      "wormhole: app_state -> window": 1,
      "wormhole: window -> app_state": 1
    },
    "layers": {},
    "cross-reexports": {},
    "impl-outside": {},
    "feature-api": {},
    "features-siblings": {},
    "frame-names-no-feature": {},
    "state-fields": {
      "wormhole :: AppState": 27,
      "wormhole :: Session": 10,
      "wormhole :: Workspace": 50
    }
  }
}
