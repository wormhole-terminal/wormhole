    "os_edge_sanctioned": {
      "wormhole": {
        "src/perf/allocations.rs": {
          "tokens": {
            "allow(unsafe_code)": 1
          },
          "why": "a counting global allocator for test and devctl builds: GlobalAlloc is an unsafe trait, not OS code"
        }
      },
      "wormhole-term": {
        "src/client/thread.rs": {
          "tokens": {
            "allow(unsafe_code)": 1
          },
          "why": "polling's registration contract (the socket outlives its registration, kept by Drop), not OS code"
        }
      },
      "wormhole-host": {
        "src/serve.rs": {
          "tokens": {
            "allow(unsafe_code)": 1
          },
          "why": "polling's registration contract (every source is deleted from the poller before it is dropped), not OS code"
        }
      }
    },
    "os_edge_neutral": {
      "wormhole-core": [
        "src/platform/"
      ],
      "wormhole-host": [
        "src/sys/"
      ],
      "wormhole-term": [
        "src/sys/"
