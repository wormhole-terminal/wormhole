# Single source of truth for app identity used by the packaging scripts.
# Sourced by scripts/*.sh (plain KEY=value lines, no logic). The version is NOT
# here: it always comes from `workspace.package.version` in the root Cargo.toml.
APP_NAME=Wormhole
# Name of the cargo binary (crates/wormhole, [[bin]] name) = Contents/MacOS/<name>.
APP_BINARY=Wormhole
# The session host (crates/wormhole-host): a second, small Mach-O next to the app's in Contents/MacOS.
# It keeps a terminal's shell alive while the app is gone; bundle.sh signs it before the bundle.
HOST_BINARY=wormhole-host
BUNDLE_ID=app.getwormhole.terminal
# The data folder in ~/Library/Application Support (store::data_dir in core). Up to 0.2 it was
# "Andromeda"; the app moves that one here at its first launch (store::migrate_legacy_data).
DATA_DIR_NAME=Wormhole
MIN_MACOS=14.0
COPYRIGHT="Copyright © 2026 Wormhole. All rights reserved."
# Update channel folder on the download host (<BASE_URL>/<channel>/latest.json).
UPDATE_CHANNEL=stable
