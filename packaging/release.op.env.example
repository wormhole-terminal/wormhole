# Where scripts/release.sh finds its secrets. Copy to packaging/release.op.env (git-ignored), then
# adjust each op:// reference to the vault, item and field where you saved it, and run
#   op run --env-file=packaging/release.op.env -- scripts/release.sh
# The references are only pointers; `op run` fills in the values for that one command and passes
# nothing on to the shell afterwards. Plain values (not secret) can be written here directly.
APPLE_TEAM_ID=
PUBLIC_BASE_URL=https://downloads.example.com

APPLE_API_KEY_ID=op://Private/Wormhole notarization/key id
APPLE_API_ISSUER=op://Private/Wormhole notarization/issuer id
# The .p8's text (scripts/notarize.sh accepts the PEM text, a path or base64 of the file).
APPLE_API_KEY_P8=op://Private/Wormhole notarization/private key

MINISIGN_SECRET_KEY=op://Private/Wormhole minisign/secret key
MINISIGN_PASSWORD=op://Private/Wormhole minisign/password

R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=op://Private/Wormhole R2 token/access key id
R2_SECRET_ACCESS_KEY=op://Private/Wormhole R2 token/secret access key
# R2_PREFIX=
# APPLE_PROVISIONING_PROFILE_PATH=
