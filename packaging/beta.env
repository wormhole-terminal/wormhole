# The identity of the Swift app's public beta, which installs beside the shipped 1.x app (packaging/app.env).
# Sourced by the beta's packaging scripts, plain KEY=value lines, no logic; a value with a space is quoted,
# so `. packaging/beta.env` reads it and a reader that strips quotes (about/mod.rs, peer.rs) does too.
# The same keys as app.env, with the beta's values, and the ones only a beta needs at the end.
#
# Nothing here may equal app.env's BUNDLE_ID or DATA_DIR_NAME: the beta never opens the 1.x folder, and the
# Swift app's data-folder rule (macos/swift/Sources/Wormhole/Isolation.swift, crates/wormhole-ffi/src/isolation.rs)
# repeats BUNDLE_ID and DATA_DIR_NAME as constants that their tests compare with this file.
# The version is NOT here: it comes from VERSION_MANIFEST.
APP_NAME="Wormhole Beta"
# The cargo product of macos/swift (Package.swift) = Contents/MacOS/<name>; the updater looks for this name.
APP_BINARY=Wormhole
HOST_BINARY=wormhole-host
BUNDLE_ID=app.getwormhole.terminal.beta
# The data folder in ~/Library/Application Support, beside 1.x's "Wormhole", which the beta never opens.
DATA_DIR_NAME="Wormhole Beta"
MIN_MACOS=26.0
COPYRIGHT="Copyright © 2026 Wormhole. All rights reserved."
# Update channel folder on the update host (<UPDATE_BASE_URL>/<channel>/...).
UPDATE_CHANNEL=beta
# The disk image's and the archive's name, without version or extension (spaces make a poor file name).
DIST_NAME=Wormhole-Beta
# A release's tag is beta-<version>, never v*: release.yml, preview.yml and preview_version (scripts/lib.sh) read v* as 1.x's.
TAG_PREFIX=beta-
UPDATE_BASE_URL=https://github.com/wormhole-terminal/wormhole/releases/download
# The manifest whose `[workspace.package] version` is the beta's (the bridge's own workspace; 1.x's is the root Cargo.toml's).
VERSION_MANIFEST=crates/wormhole-ffi/Cargo.toml
