# The colour picker: a control that chooses the theme's colour, one of eight presets or a colour of your own.
# The presets are named by the folder colours (Red to Pink), which the interface says in English everywhere.

# The choice that follows the theme.
color-pick-theme = Theme's colour

# The choice that opens the saturation, brightness, hue and hex controls.
color-pick-custom = Custom…

# What the face of the control says for a colour of your own that has no hex code yet.
color-pick-custom-face = Custom

# VoiceOver: what the area and the hue slider are called, and the field for the hex code.
color-pick-area = Saturation and brightness
color-pick-hue = Hue
color-pick-hex = Hex colour

# VoiceOver: the area's value. { $saturation } and { $brightness } are whole percents.
color-pick-area-value = { $saturation } percent saturation, { $brightness } percent brightness

# VoiceOver: the hue slider's value. { $degrees } is a whole number of degrees.
color-pick-hue-value = { $degrees } degrees

# Under the hex field when what was typed is not a colour.
color-pick-hex-bad = Not a colour. Use a hex code such as #a35cf2.

# The button that closes the custom colour.
color-pick-done = Done
