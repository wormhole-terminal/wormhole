# Zen mode: the window shows only the terminal list and the terminal, for a while and without saving it.

# What VoiceOver says when it goes on or off.
zen-on = Zen mode on
zen-off = Zen mode off

# The note at the top of the settings pages it affects (Appearance, Terminal). The rows below show the
# person's own values, which Zen mode leaves alone.
zen-settings-note = Zen mode is on, so the window shows less than these settings say. They keep your own values and apply again when you leave it.
zen-settings-leave = Leave Zen mode

# The right panel's button while Zen mode is on: why there is no panel, and that a click leaves Zen mode.
# The key that does so follows in brackets.
zen-panel-hidden = Zen mode hides the right panel · Click to leave Zen mode
