# The terminal's title row: the names of its parts, in Settings and in the menu a right-click on the
# row opens, and that menu's own words.

title-row-part-folder = Folder
title-row-part-branch = Branch
title-row-part-branch-status = Branch status
title-row-part-terminal = Terminal name
title-row-part-terminal-status = Terminal status
title-row-part-space = Flexible space
    .description = Parts above it sit at the left, parts below it at the right
title-row-part-agent-gauge = Agent model and context
title-row-part-ports = Open ports
title-row-part-pull-request = Pull request
title-row-part-open-in = Open in…
title-row-part-splits = Split buttons

## The row's menu

title-row-menu-header = Show in title row
title-row-menu-reset = Reset title row
title-row-menu-customize = Customize title row…

## The one button Open in… and the splits fold into where the row is narrow

title-row-more-open-in-split = Open in, split
title-row-more-open-in = Open in
title-row-more-split = Split

## Settings

# Over the parts the row doesn't show.
title-row-hidden = Hidden
# Beside Terminal status while the status bar is on, which says it instead.
title-row-status-in-bar = The status bar shows it while it's on

## The card under the folder in the title row, and the menu of a right-click on it

# Button on the card and item in the menu: shows the folder in Finder.
title-row-path-open-in-finder = Open in Finder

# Button on the card and item in the menu: puts the folder's whole path on the clipboard.
title-row-path-copy = Copy path

# The card's Copy path button for a moment after it was clicked.
title-row-path-copied = Copied

# What VoiceOver says after the card's Copy path button was clicked.
title-row-path-spoken-copied = Path copied
