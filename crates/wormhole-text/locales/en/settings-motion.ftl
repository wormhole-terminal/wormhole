# Settings window, motion page: the page's title and intro, its groups and the rows in them, the options of each
# choice and what the previews say. A row is its label, with the quiet line under it (.description) and the extra
# words search finds it by (.keywords).

settings-section-motion = Motion
    .intro = How things move. Pick one for each, and watch it loop in the preview under it.

## Terminals list

settings-motion-group-terminals = Terminals list

settings-motion-insert = A terminal opens or closes
    .description = How its row comes into the list and leaves it
    .keywords = animation animate new row appear disappear add remove list insert spring slide fade

settings-motion-fold = A group folds
    .description = How a group's rows go away when you fold it, and come back when you open it
    .keywords = animation animate collapse expand band group fold drawer tuck

settings-motion-status = A status changes
    .description = What a terminal's tile does when its agent starts working, needs you or finishes
    .keywords = animation animate tile badge agent working needs input done failed crossfade wash flare nudge roll

## Window

settings-motion-group-window = Window

settings-motion-column = The sidebar and panel hide or show
    .description = How a column slides in and out
    .keywords = animation animate sidebar panel column slide spring hide show collapse

