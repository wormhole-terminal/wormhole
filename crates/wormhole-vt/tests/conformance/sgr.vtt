# SGR: every attribute, the 16, 256 and truecolor forms with semicolons and colons, underline
# styles and the underline color.

test SGR 0 is normal rendition
spec xterm ctlseqs SGR Ps = 0: Normal; ECMA-48 8.3.117
size 20 3
feed \e[1;3;4;7;31;42m\e[0mx
cell 1,1 text=x fg=default bg=default ul=default attrs=none

test SGR with no parameter is SGR 0
spec ECMA-48 8.3.117: the default parameter is 0
size 20 3
feed \e[1;31mx\e[my
cell 1,2 text=y fg=default attrs=none

test an empty SGR parameter is 0
spec ECMA-48 5.4.2: an omitted parameter has its default value, which for SGR is 0
size 20 3
feed \e[1;;3mx
cell 1,1 text=x attrs=italic

test SGR 1 is bold
spec xterm ctlseqs SGR Ps = 1; ECMA-48 8.3.117
size 20 3
feed \e[1mx
cell 1,1 text=x attrs=bold fg=default

test SGR 2 is faint
spec xterm ctlseqs SGR Ps = 2; ECMA-48 8.3.117
size 20 3
feed \e[2mx
cell 1,1 text=x attrs=dim

test SGR 3 is italic
spec xterm ctlseqs SGR Ps = 3
size 20 3
feed \e[3mx
cell 1,1 text=x attrs=italic

test SGR 4 is underline
spec xterm ctlseqs SGR Ps = 4
size 20 3
feed \e[4mx
cell 1,1 text=x attrs=underline

test SGR 5 is blink
spec xterm ctlseqs SGR Ps = 5; ECMA-48 8.3.117 slowly blinking
known-fail: alacritty – SGR 5 sets no attribute
size 20 3
feed \e[5mx
cell 1,1 text=x attrs=blink

test SGR 7 is inverse and keeps the colors as set
spec xterm ctlseqs SGR Ps = 7; the colors are the program's, drawing swaps them
size 20 3
feed \e[7;31;42mx
cell 1,1 text=x attrs=inverse fg=idx:1 bg=idx:2

test SGR 8 is hidden
spec xterm ctlseqs SGR Ps = 8
size 20 3
feed \e[8mx
cell 1,1 text=x attrs=hidden

test SGR 9 is crossed out
spec xterm ctlseqs SGR Ps = 9
size 20 3
feed \e[9mx
cell 1,1 text=x attrs=strike

test SGR 21 is double underline
spec xterm ctlseqs SGR Ps = 21: Doubly-underlined; ECMA-48 8.3.117
known-fail: alacritty – SGR 21 sets no double underline
size 20 3
feed \e[21mx
cell 1,1 text=x attrs=double-underline

test SGR 53 is overline
spec ECMA-48 8.3.117: 53 overlined
known-fail: alacritty – SGR 53 sets no attribute
size 20 3
feed \e[53mx
cell 1,1 text=x attrs=overline

test SGR 22 ends bold and faint
spec xterm ctlseqs SGR Ps = 22: Normal (neither bold nor faint)
size 20 3
feed \e[1;2m\e[22mx
cell 1,1 text=x attrs=none

test SGR 22 leaves the other attributes
spec xterm ctlseqs SGR Ps = 22
size 20 3
feed \e[1;3m\e[22mx
cell 1,1 text=x attrs=italic

test SGR 23 ends italic
spec xterm ctlseqs SGR Ps = 23
size 20 3
feed \e[3m\e[23mx
cell 1,1 text=x attrs=none

test SGR 24 ends underline
spec xterm ctlseqs SGR Ps = 24
size 20 3
feed \e[4m\e[24mx
cell 1,1 text=x attrs=none

test SGR 24 ends double underline too
spec ECMA-48 8.3.117: 24 not underlined (neither singly nor doubly)
size 20 3
feed \e[21m\e[24mx
cell 1,1 text=x attrs=none

test SGR 25 ends blink
spec xterm ctlseqs SGR Ps = 25
size 20 3
feed \e[5m\e[25mx
cell 1,1 text=x attrs=none

test SGR 27 ends inverse
spec xterm ctlseqs SGR Ps = 27
size 20 3
feed \e[7m\e[27mx
cell 1,1 text=x attrs=none

test SGR 28 ends hidden
spec xterm ctlseqs SGR Ps = 28
size 20 3
feed \e[8m\e[28mx
cell 1,1 text=x attrs=none

test SGR 29 ends crossed out
spec xterm ctlseqs SGR Ps = 29
size 20 3
feed \e[9m\e[29mx
cell 1,1 text=x attrs=none

test SGR 55 ends overline
spec ECMA-48 8.3.117: 55 not overlined
size 20 3
feed \e[53m\e[55mx
cell 1,1 text=x attrs=none

test attributes combine
spec ECMA-48 8.3.117: the aspects stay in effect until the next SGR
size 20 3
feed \e[1;3;4;9mx
cell 1,1 text=x attrs=bold,italic,underline,strike

test attributes are cumulative across sequences
spec ECMA-48 8.3.117
size 20 3
feed \e[1m\e[3mx
cell 1,1 text=x attrs=bold,italic

test underline style 4:0 is none
spec kitty underlines: ESC[4:0m no underline
size 20 3
feed \e[4m\e[4:0mx
cell 1,1 text=x attrs=none

test underline style 4:1 is single
spec kitty underlines: ESC[4:1m straight underline
size 20 3
feed \e[4:1mx
cell 1,1 text=x attrs=underline

test underline style 4:2 is double
spec kitty underlines: ESC[4:2m double underline
size 20 3
feed \e[4:2mx
cell 1,1 text=x attrs=double-underline

test underline style 4:3 is curly
spec kitty underlines: ESC[4:3m curly underline
size 20 3
feed \e[4:3mx
cell 1,1 text=x attrs=curly-underline

test underline style 4:4 is dotted
spec kitty underlines: ESC[4:4m dotted underline
size 20 3
feed \e[4:4mx
cell 1,1 text=x attrs=dotted-underline

test underline style 4:5 is dashed
spec kitty underlines: ESC[4:5m dashed underline
size 20 3
feed \e[4:5mx
cell 1,1 text=x attrs=dashed-underline

test a new underline style replaces the old one
spec kitty underlines: one style at a time
size 20 3
feed \e[4:3m\e[4:2mx
cell 1,1 text=x attrs=double-underline

test SGR 24 ends a curly underline
spec kitty underlines: ESC[24m no underline (for backwards compat)
size 20 3
feed \e[4:3m\e[24mx
cell 1,1 text=x attrs=none

test SGR 30 to 37 set the foreground to palette 0 to 7
spec xterm ctlseqs SGR Ps = 30-37
size 20 3
feed \e[31mx\e[37my
cell 1,1 text=x fg=idx:1
cell 1,2 text=y fg=idx:7

test SGR 40 to 47 set the background to palette 0 to 7
spec xterm ctlseqs SGR Ps = 40-47
size 20 3
feed \e[42mx\e[40my
cell 1,1 text=x bg=idx:2
cell 1,2 text=y bg=idx:0

test SGR 90 to 97 set the bright foreground, palette 8 to 15
spec xterm ctlseqs: aixterm 90-97 are the bright versions, the second 8 of 16
size 20 3
feed \e[91mx\e[97my
cell 1,1 text=x fg=idx:9
cell 1,2 text=y fg=idx:15

test SGR 100 to 107 set the bright background, palette 8 to 15
spec xterm ctlseqs: aixterm 100-107
size 20 3
feed \e[101mx\e[107my
cell 1,1 text=x bg=idx:9
cell 1,2 text=y bg=idx:15

test SGR 39 resets only the foreground
spec xterm ctlseqs SGR Ps = 39
size 20 3
feed \e[31;42m\e[39mx
cell 1,1 text=x fg=default bg=idx:2

test SGR 49 resets only the background
spec xterm ctlseqs SGR Ps = 49
size 20 3
feed \e[31;42m\e[49mx
cell 1,1 text=x fg=idx:1 bg=default

test foreground and background are set together
spec ECMA-48 8.3.117
size 20 3
feed \e[33;44mx
cell 1,1 text=x fg=idx:3 bg=idx:4

test bold does not change the color
spec xterm ctlseqs: bold is an attribute; the palette entry is the one asked for
size 20 3
feed \e[1;31mx
cell 1,1 text=x fg=idx:1 attrs=bold

test SGR 38;5 sets an indexed foreground
spec xterm ctlseqs: Ps = 38 ; 5 ; Ps (legacy semicolons)
size 20 3
feed \e[38;5;123mx
cell 1,1 text=x fg=idx:123

test SGR 48;5 sets an indexed background
spec xterm ctlseqs: Ps = 48 ; 5 ; Ps (legacy semicolons)
size 20 3
feed \e[48;5;200mx
cell 1,1 text=x bg=idx:200

test SGR 38:5 sets an indexed foreground
spec xterm ctlseqs: Ps = 38 : 5 : Ps
size 20 3
feed \e[38:5:45mx
cell 1,1 text=x fg=idx:45

test SGR 48:5 sets an indexed background
spec xterm ctlseqs: Ps = 48 : 5 : Ps
size 20 3
feed \e[48:5:99mx
cell 1,1 text=x bg=idx:99

test an indexed color below 16 is the same palette entry as 30 to 37
spec xterm ctlseqs: indexed color Ps is palette entry Ps
size 20 3
feed \e[38;5;1mx
cell 1,1 text=x fg=idx:1

test SGR 38;2 sets a truecolor foreground
spec xterm ctlseqs: Ps = 38 ; 2 ; Pr ; Pg ; Pb
size 20 3
feed \e[38;2;10;20;30mx
cell 1,1 text=x fg=rgb:0a141e

test SGR 48;2 sets a truecolor background
spec xterm ctlseqs: Ps = 48 ; 2 ; Pr ; Pg ; Pb
size 20 3
feed \e[48;2;255;128;0mx
cell 1,1 text=x bg=rgb:ff8000

test SGR 38:2 with a color space id sets a truecolor foreground
spec xterm ctlseqs: Ps = 38 : 2 : Pi : Pr : Pg : Pb, the color space identifier is ignored
size 20 3
feed \e[38:2::10:20:30mx
cell 1,1 text=x fg=rgb:0a141e

test SGR 48:2 with a color space id sets a truecolor background
spec xterm ctlseqs: Ps = 48 : 2 : Pi : Pr : Pg : Pb
size 20 3
feed \e[48:2:0:255:128:0mx
cell 1,1 text=x bg=rgb:ff8000

test SGR 38:2 without a color space id sets a truecolor foreground
convention the form many programs send, ISO 8613-6 without the optional color space id
size 20 3
feed \e[38:2:10:20:30mx
cell 1,1 text=x fg=rgb:0a141e

test a color sequence can sit between other attributes
spec xterm ctlseqs: the subparameters belong to their 38/48
size 20 3
feed \e[1;38;5;100;4;48;2;1;2;3;3mx
cell 1,1 text=x attrs=bold,underline,italic fg=idx:100 bg=rgb:010203

test colon colors can sit between other attributes
spec xterm ctlseqs: after the first colon, colons must be used
size 20 3
feed \e[1;38:5:100;4mx
cell 1,1 text=x attrs=bold,underline fg=idx:100

test a color cut short by the end of the sequence sets nothing and keeps the other attributes
convention a 38 or 48 whose numbers run out is not a color; ECMA-48 and ITU-T T.416 give no meaning to a part of one
size 20 3
feed \e[1;38;2;1;2mx\e[0;3;48;5mx
cell 1,1 text=x attrs=bold fg=default
cell 1,2 text=x attrs=italic bg=default

test a color number outside 0 to 255 sets nothing
convention the palette has 256 entries and a channel is one byte (ITU-T T.416 8.3.117 direct colors)
size 20 3
feed \e[38;5;300mx\e[38;2;300;0;0my\e[38:5:256mz
cell 1,1 text=x fg=default
cell 1,2 text=y fg=default
cell 1,3 text=z fg=default

test colon and semicolon colors can follow each other in one sequence
spec xterm ctlseqs: the subparameters of 38/48/58 are separated by colons or by semicolons; kitty underline documentation: 4:5 is dashed
size 20 3
feed \e[4:5;38;5;196;48:2::1:2:3mx
cell 1,1 text=x attrs=dashed-underline fg=idx:196 bg=rgb:010203

test an underline style the protocol does not have changes nothing
spec kitty underline documentation: 4:0 none, 4:1 straight, 4:2 double, 4:3 curly, 4:4 dotted, 4:5 dashed
size 20 3
feed \e[4:9mx\e[4:3my\e[4:9mz
cell 1,1 text=x attrs=none
cell 1,2 text=y attrs=curly-underline
cell 1,3 text=z attrs=curly-underline

test SGR 0 resets colors as well
spec xterm ctlseqs SGR Ps = 0
size 20 3
feed \e[38;2;1;2;3;48;5;9m\e[0mx
cell 1,1 text=x fg=default bg=default

test SGR 58 sets an indexed underline color
spec kitty underlines: ESC[58...m works exactly like 38 and 48
size 20 3
feed \e[4;58;5;9mx
cell 1,1 text=x attrs=underline ul=idx:9

test SGR 58 sets a truecolor underline color
spec kitty underlines: ESC[58...m works exactly like 38 and 48
size 20 3
feed \e[4;58;2;255;0;0mx
cell 1,1 text=x ul=rgb:ff0000

test SGR 58:2 sets a truecolor underline color
spec kitty underlines: 58 works like 38 and 48; xterm ctlseqs 38 : 2 : Pi : Pr : Pg : Pb
size 20 3
feed \e[4:3;58:2::255:0:0mx
cell 1,1 text=x attrs=curly-underline ul=rgb:ff0000

test SGR 59 resets the underline color
spec kitty underlines: ESC[59m resets the underline color
size 20 3
feed \e[58;5;9m\e[59mx
cell 1,1 text=x ul=default

test SGR 0 resets the underline color
spec ECMA-48 8.3.117: 0 cancels the effect of any preceding SGR
size 20 3
feed \e[58;5;9m\e[0mx
cell 1,1 text=x ul=default

test the underline color does not change the text colors
spec kitty underlines
size 20 3
feed \e[31;58;5;4mx
cell 1,1 text=x fg=idx:1 ul=idx:4
test text written before an SGR keeps its rendition
spec ECMA-48 8.3.117: SGR establishes aspects for subsequent text
size 20 3
feed a\e[1mb
cell 1,1 text=a attrs=none
cell 1,2 text=b attrs=bold

test the rendition goes on across line feeds
spec ECMA-48 8.3.117: the aspects stay until the next SGR
size 20 3
feed \e[1;31mab\r\ncd
cell 2,2 text=d attrs=bold fg=idx:1

test the rendition goes on across a wrap
spec ECMA-48 8.3.117: the aspects stay until the next SGR
size 4 3
feed \e[44mabcdef
cell 2,1 text=e bg=idx:4

test blanks written with a rendition carry it
spec ECMA-48 8.3.117: SGR applies to subsequent text, a space is text
size 20 3
feed \e[44m\s\s\s
cell 1,2 text=\s bg=idx:4

test an untouched cell has the default rendition
spec ECMA-48 8.3.117 / ECMA-48 8.3.38: erased positions
size 20 3
feed \e[1;31mx
cell 1,5 text=\s fg=default bg=default attrs=none ul=default link=none width=1
