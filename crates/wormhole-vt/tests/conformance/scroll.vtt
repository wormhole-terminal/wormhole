# Scrolling: LF, IND, NEL and RI at the margins, DECSTBM, SU, SD and what reaches the history.
#
# Most cases use the screen "A", "B", "C", "D" (one letter on each of four rows).

test line feed on the last row scrolls the screen up
spec VT100 User Guide IND/NEL: at the bottom margin a scroll up is performed
size 10 4
feed A\r\nB\r\nC\r\nD\n
screen
|B|
|C|
|D|
| |
cursor 4,2
scrollback
|A|

test the lines scrolled off keep their order in the history
spec xterm ctlseqs: saved lines (scrollback) hold what scrolls off the top
size 10 3
feed 1\r\n2\r\n3\r\n4\r\n5\r\n6
screen
|4|
|5|
|6|
scrollback
|1|
|2|
|3|

test the history keeps at most the lines it is allowed
spec xterm ctlseqs: saveLines; the oldest lines are dropped first
size 10 3
scrollback-limit 2
feed 1\r\n2\r\n3\r\n4\r\n5\r\n6
scrollback
|2|
|3|

test DECSTBM moves the cursor home
spec VT510 DECSTBM: the cursor moves to column 1, line 1
size 10 4
feed \e[3;3H\e[2;3r
cursor 1,1

test DECSTBM without parameters removes the region
spec VT510 DECSTBM: defaults top 1, bottom the last line
size 10 4
feed A\r\nB\r\nC\r\nD\e[2;3r\e[r\e[4;1H\n
screen
|B|
|C|
|D|
| |

test line feed at the bottom margin scrolls only the region
spec VT100 User Guide IND: at the bottom margin a scroll up is performed
size 10 4
feed A\r\nB\r\nC\r\nD\e[2;3r\e[3;1H\n
screen
|A|
|C|
| |
|D|
cursor 3,1
scrollback-len 0

test line feed in a region that starts at the top feeds the history
convention lines leaving the top of the screen are saved even when the bottom margin is above the last row
size 10 4
feed A\r\nB\r\nC\r\nD\e[1;3r\e[3;1H\n
screen
|B|
|C|
| |
|D|
scrollback
|A|

test line feed below the region on the last row does not scroll
spec VT510 IND: the scroll happens only at the bottom margin
size 10 4
feed A\r\nB\r\nC\r\nD\e[2;3r\e[4;1H\n
screen
|A|
|B|
|C|
|D|
cursor 4,1

test line feed below the region moves down
spec VT100 User Guide IND: the active position moves down one line
size 10 4
feed A\r\nB\r\nC\r\nD\e[1;2r\e[3;1H\n
cursor 4,1
screen
|A|
|B|
|C|
|D|

test reverse index at the top margin scrolls the region down
spec VT100 User Guide RI: at the top margin a scroll down is performed
size 10 4
feed A\r\nB\r\nC\r\nD\e[2;3r\e[2;1H\eM
screen
|A|
| |
|B|
|D|
cursor 2,1

test reverse index on the first row scrolls the whole screen down
spec VT100 User Guide RI: at the top margin a scroll down is performed
size 10 4
feed A\r\nB\r\nC\r\nD\e[1;1H\eM
screen
| |
|A|
|B|
|C|
scrollback-len 0

test reverse index above the region moves nowhere
convention the top row has no line above it, and above the margin nothing scrolls
size 10 4
feed A\r\nB\r\nC\r\nD\e[2;3r\e[1;1H\eM
screen
|A|
|B|
|C|
|D|
cursor 1,1

test reverse index inside the region moves up
spec VT100 User Guide RI: the active position moves to the preceding line
size 10 4
feed A\r\nB\r\nC\r\nD\e[2;3r\e[3;1H\eM
cursor 2,1
screen
|A|
|B|
|C|
|D|

test index keeps the column and scrolls at the bottom margin
spec VT100 User Guide IND: without changing the column; at the bottom margin a scroll up
size 10 4
feed A\r\nB\r\nC\r\nD\e[2;3r\e[3;5H\eD
screen
|A|
|C|
| |
|D|
cursor 3,5

test next line scrolls at the bottom margin and returns the carriage
spec VT100 User Guide NEL: first position of the next line; at the bottom margin a scroll up
size 10 4
feed A\r\nB\r\nC\r\nD\e[2;3r\e[3;5H\eE
screen
|A|
|C|
| |
|D|
cursor 3,1

test SU scrolls the screen up and leaves the cursor
spec ECMA-48 8.3.147 SU; xterm ctlseqs CSI Ps S
size 10 4
feed A\r\nB\r\nC\r\nD\e[2;2H\e[S
screen
|B|
|C|
|D|
| |
cursor 2,2

test SU moves the lines into the history
spec xterm ctlseqs: saved lines hold what scrolls off the top
size 10 4
feed A\r\nB\r\nC\r\nD\e[2S
scrollback
|A|
|B|

test SU with a huge count clears the screen
spec ECMA-48 8.3.147 SU
size 10 4
feed A\r\nB\r\nC\r\nD\e[99S
screen
| |

test SD scrolls the screen down
spec ECMA-48 8.3.113 SD; xterm ctlseqs CSI Ps T
size 10 4
feed A\r\nB\r\nC\r\nD\e[2;2H\e[T
screen
| |
|A|
|B|
|C|
cursor 2,2

test SD by several lines
spec ECMA-48 8.3.113 SD
size 10 4
feed A\r\nB\r\nC\r\nD\e[2T
screen
| |
| |
|A|
|B|

test SU scrolls only the region
convention SU and SD move the lines of the scrolling region, as LF and RI at its margins do
size 10 4
feed A\r\nB\r\nC\r\nD\e[2;3r\e[S
screen
|A|
|C|
| |
|D|
scrollback-len 0

test SD scrolls only the region
convention SU and SD move the lines of the scrolling region, as LF and RI at its margins do
size 10 4
feed A\r\nB\r\nC\r\nD\e[2;3r\e[T
screen
|A|
| |
|B|
|D|

test an invalid region is ignored
spec VT100 User Guide DECSTBM: the top margin must be less than the bottom margin
size 10 4
feed A\r\nB\r\nC\r\nD\e[2;3r\e[3;3r\e[3;1H\n
screen
|A|
|C|
| |
|D|

test a bottom margin beyond the screen is the last row
convention the margins stay on the page
size 10 4
feed A\r\nB\r\nC\r\nD\e[2;99r\e[4;1H\n
screen
|A|
|C|
|D|
| |

test DECSTBM with only a top margin
spec VT510 DECSTBM: the bottom margin defaults to the last line
size 10 4
feed A\r\nB\r\nC\r\nD\e[3r\e[4;1H\n
screen
|A|
|B|
|D|
| |

test scrolling a region in the middle of the screen keeps text outside it
spec VT100 User Guide DECSTBM: the scrolling region is the lines between the margins
size 10 5
feed 1\r\n2\r\n3\r\n4\r\n5\e[2;4r\e[4;1H\n\n
screen
|1|
|4|
| |
| |
|5|

test erasing the screen leaves the region alone
convention the margins are state of the terminal, not of the screen contents
size 10 4
feed \e[2;3r\e[2J\e[3;1H\nX
screen
| |
| |
|X|
| |

test an invalid DECSTBM leaves the cursor where it is
spec VT100 User Guide DECSTBM: the top margin must be less than the bottom; a request that breaks that is ignored, and the cursor goes home only when the margins are set
size 10 4
feed \e[3;3H\e[3;3r
cursor 3,3
